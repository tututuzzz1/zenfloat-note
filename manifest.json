{
  "manifest_version": 3,
  "name": "ZenFloat Note",
  "version": "1.0.19",
  "description": "A minimalist floating note-taking tool using Document Picture-in-Picture API.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ZenFloat Note"
  }
}
